[Unit]
Description=Generate daily Anki Lingo flashcards
After=graphical-session.target

[Service]
Type=oneshot
WorkingDirectory=%h/Development/personal/anki-lingo
EnvironmentFile=%h/.config/anki-lingo/anki-lingo.env
ExecStart=/usr/bin/flock -n %t/anki-lingo.lock %h/Development/personal/anki-lingo/.venv/bin/anki-lingo generate
