# Copy this file to `.env` and adjust the values for your machine.
# Never commit credentials or personal configuration.

# Anki target (required for a real insertion)
ANKI_DECK_NAME=English
ANKI_NOTE_TYPE=Basic
ANKI_FIELD_FRONT=Front
ANKI_FIELD_BACK=Back
ANKI_CONNECT_URL=http://127.0.0.1:8765

# Generation defaults
ANKI_LINGO_PROVIDER=opencode
ANKI_LINGO_COUNT=10
ANKI_LINGO_CEFR_LEVEL=C1/C2
ANKI_LINGO_NATIVE_LANGUAGE=pt-BR
ANKI_LINGO_MAX_ATTEMPTS=3

# Timeouts, in seconds
ANKI_CONNECT_TIMEOUT_SECONDS=10
OPENCODE_TIMEOUT_SECONDS=120

# Optional OpenCode settings
OPENCODE_BIN=opencode
# Use the exact provider/model returned by `opencode models`.
OPENCODE_MODEL=
OPENCODE_WORKING_DIRECTORY=
